# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "CLI tool to export Excalidraw files to SVG and edit them visually"
depends: [
  "ocaml" {>= "5.1"}
  "dune" {>= "3.14" & >= "3.14"}
  "yojson" {>= "2.0"}
  "tyxml" {>= "4.0"}
  "cmdliner" {>= "1.2"}
  "cohttp-eio" {>= "6.0"}
  "eio" {>= "1.0"}
  "eio_main" {>= "1.0"}
  "crunch" {>= "3.0"}
  "alcotest" {>= "1.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
